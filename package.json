{
  "name": "dsh-mail-bridge",
  "version": "0.1.0",
  "description": "用一封邮件遥控家里那台没有公网 IP 的电脑上的 DSH 干活。Email as a command channel for DSH running on a NAT-ed machine.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "email",
    "imap",
    "smtp",
    "remote-control",
    "automation",
    "nat-traversal",
    "self-hosted",
    "mail-bot"
  ],
  "license": "MIT",
  "author": "",
  "private": true,
  "type": "commonjs",
  "main": "src/index.js",
  "bin": {
    "dsh-mail-bridge": "bin/cli.js"
  },
  "files": [
    "bin/",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node bin/cli.js start",
    "init": "node bin/cli.js init",
    "doctor": "node bin/cli.js doctor",
    "test": "node tests/run-all.js"
  },
  "dependencies": {
    "imapflow": "^2.4.0",
    "mailparser": "^3.9.38",
    "nodemailer": "^10.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QIKO0721/dsh-mail-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/QIKO0721/dsh-mail-bridge/issues"
  },
  "homepage": "https://github.com/QIKO0721/dsh-mail-bridge#readme"
}
